# Public URL of the site (no trailing slash). Used for canonical URLs, sitemap, Open Graph, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.etc-sat-maroc.com

# Contact form — Resend (https://resend.com). Without RESEND_API_KEY the form shows a clear error state.
RESEND_API_KEY=
# Recipient of contact requests (defaults to contact@etc-sat-maroc.com)
CONTACT_TO_EMAIL=contact@etc-sat-maroc.com
# Sender — must belong to a domain verified in Resend, e.g. "ETC SAT MAROC <site@etc-sat-maroc.com>"
CONTACT_FROM_EMAIL=
